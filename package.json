{
  "name": "@monochrome-ai/core",
  "version": "0.3.0",
  "description": "App-neutral AI runtime and security primitives shared across Monochrome applications.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm test"
  },
  "peerDependencies": {
    "@ai-sdk/harness": ">=1.0.166 <2",
    "@ai-sdk/harness-codex": ">=1.0.168 <2",
    "@openai/codex": ">=0.160.1 <1",
    "ai": ">=7 <8",
    "ws": ">=8 <9"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.48",
    "typescript": "^5.8.3"
  }
}
